<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pension.mapper.pensionMapper">
    <select id="selectAdmin" resultType="com.pension.vo.adminVo">
        SELECT USERID
        FROM ADMIN
        WHERE USERID = #{userId}
            AND USERPW = #{userPw}
    </select>

    <select id="room" resultType="java.util.Map">
        SELECT roomType,
               roomNm,
               roomCnt,
               roomFull
        FROM room
    </select>

</mapper>